    <!-- so that is how we can override but make sure the repo is availabe remotly then it will work if not maven will throw and error-->

    <properties> <!-- These are properties field which stored as key-value pain-->
        <java>23</java>  <!-- i ca also create my own property and it can be reused -->
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
